// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
	"agent": {
		"default_model": {
			"provider": "google",
			"model": "gemini-2.5-pro"
		}
	},
	"icon_theme": "Bearded Icon Theme",
	"ui_font_size": 16,
	"buffer_font_size": 16,
	"theme": {
		"mode": "system",
		"light": "One Dark",
		"dark": "Moxer Blur"
	},
	"tabs": {
		"file_icons": true
	},
	"buffer_font_family": "Intel One Mono",
	"lsp": {
		"tailwindcss-language-server": {
			"settings": {
				"tailwindCSS": {
					"emmetCompletions": true
				}
			}
		},
		// ref: https://github.com/zed-industries/zed/issues/7626
		"typescript-language-server": {
			"settings": {
				"preferences": {
					"importModuleSpecifierPreference": "non-relative"
				}
			}
		},
		// "vtsls": {
		// 	"settings": {
		// 		"typescript": {
		// 			"preferences": {
		// 				"importModuleSpecifier": "non-relative"
		// 			}
		// 		}
		// 	}
		// }
	},
	// ref. https://biomejs.dev/reference/zed/
	"languages": {
		"JavaScript": { "formatter": { "language_server": { "name": "biome" } } },
		"TypeScript": { "formatter": { "language_server": { "name": "biome" } } },
		"TSX": { "formatter": { "language_server": { "name": "biome" } } },
		"JSON": { "formatter": { "language_server": { "name": "biome" } } },
		"JSONC": { "formatter": { "language_server": { "name": "biome" } } },
		"CSS": { "formatter": { "language_server": { "name": "biome" } } }
	},
	"terminal": {
		// ref. https://github.com/zed-industries/zed/issues/14476#issuecomment-2476370864
		"font_family": "BlexMono Nerd Font Mono",
		"font_size": 14
	}
}
